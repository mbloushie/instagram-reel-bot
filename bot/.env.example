# Instagram (Meta developer app -> Instagram -> API setup with Instagram login)
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=pick-any-random-string
IG_API_VERSION=v25.0
# Fill after first message: the server log prints your sender id
ALLOWED_SENDER_ID=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=1500
WEB_SEARCH=false
REPLY_LANGUAGE=Arabic

# Video
MAX_FRAMES=16
FRAME_WIDTH=768
TRANSCRIBE=true
WHISPER_MODEL=small

# Storage
DATA_DIR=./data
HISTORY_LIMIT=30

# Tunnel: your free static ngrok domain (no https://), used by install-autostart.ps1
NGROK_DOMAIN=

# Optional: secret key for the live history page at https://<NGROK_DOMAIN>/history?k=<HISTORY_KEY>
HISTORY_KEY=

# Optional: start a Claude Code research session per reel (scheduled task with an API trigger)
ROUTINE_ENABLED=false
ROUTINE_FIRE_URL=
ROUTINE_TOKEN=
